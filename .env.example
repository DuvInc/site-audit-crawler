# Copy to .env (never committed). A real environment variable always wins over this file.

# The AI layer (--ai). https://openrouter.ai/keys. Paid per call: about $0.06 per 250 pages measured.
# --budget is a hard cap per run (worst case reserved before each call); a key credit limit in OpenRouter is a second fence.
OPENROUTER_API_KEY=
# Optional: a gateway in front of OpenRouter (e.g. a Cloudflare AI Gateway URL ending in /api).
# OPENROUTER_BASE_URL=

# Search Console with your own Google access (--gsc google). Free. One of the two:
# GOOGLE_APPLICATION_CREDENTIALS=/path/outside/the/repo/service-account.json
# GSC_ACCESS_TOKEN=
# With treg instead (--gsc treg), nothing goes here: run `treg connections connect --provider google-search-console`.

# Rendering uses the installed Google Chrome. Point at another Chrome or Chromium if needed.
# CHROME_PATH=
